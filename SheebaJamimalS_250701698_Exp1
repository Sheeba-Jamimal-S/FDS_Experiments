        "from cryptography.fernet import Fernet\n",
        "\n",
        "# 1. Generate a Fernet key\n",
        "# This key is crucial. It must be kept secret and used for both encryption and decryption.\n",
        "# In a real-world scenario, you would securely store and retrieve this key.\n",
        "key = Fernet.generate_key()\n",
        "f = Fernet(key)\n",
        "\n",
        "print(f\"Generated Fernet Key: {key.decode()}\")\n",
        "\n",
        "# 2. Define sensitive data to be encrypted\n",
        "sensitive_data = \"This is a top secret message that needs to be encrypted.\"\n",
        "print(f\"\\nOriginal Sensitive Data: {sensitive_data}\")\n",
        "\n",
        "# Convert the string data to bytes, as Fernet works with bytes\n",
        "sensitive_data_bytes = sensitive_data.encode()\n",
        "\n",
        "# 3. Encrypt the data\n",
        "encrypted_data = f.encrypt(sensitive_data_bytes)\n",
        "print(f\"Encrypted Data: {encrypted_data.decode()}\")\n",
        "\n",
        "# 4. Decrypt the data\n",
        "decrypted_data_bytes = f.decrypt(encrypted_data)\n",
        "\n",
        "# Convert the decrypted bytes back to a string\n",
        "decrypted_data = decrypted_data_bytes.decode()\n",
        "print(f\"Decrypted Data: {decrypted_data}\")\n",
        "\n",
        "# Verification\n",
        "if sensitive_data == decrypted_data:\n",
        "    print(\"\\nEncryption and Decryption successful! Original and decrypted data match.\")\n",
        "else:\n",
        "    print(\"\\nError: Original and decrypted data do NOT match.\")\n"
